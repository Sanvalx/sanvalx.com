RewriteEngine On

# Formulario de contacto con token CSRF (URL pública sigue siendo contacto.html)
RewriteRule ^contacto\.html$ contacto.php [L]

# Forzar HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Opcional: redirigir www a dominio sin www (descomenta si quieres)
# RewriteCond %{HTTP_HOST} ^www\.sanvalx\.com$ [NC]
# RewriteRule ^(.*)$ https://sanvalx.com/$1 [L,R=301]

# Servir 404 personalizada
ErrorDocument 404 /404.html

# Seguridad: no permitir acceso directo a config (credenciales BD)
<IfModule mod_authz_core.c>
  <FilesMatch "\.(env|ini|log|sql)$">
    Require all denied
  </FilesMatch>
</IfModule>
RewriteRule ^config/ - [F,L]
RewriteRule ^database/ - [F,L]
RewriteRule ^scripts/ - [F,L]
RewriteRule ^includes/ - [F,L]
RewriteRule ^storage/ - [F,L]

# --- INICIO BLOQUE SEGURIDAD ---
# Bloquear listado de directorios y ocultar firma del servidor
Options -Indexes
ServerSignature Off

# Cabeceras de Seguridad HTTP
<IfModule mod_headers.c>
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
    Header set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://connect.facebook.net https://www.clarity.ms; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com https://www.clarity.ms https://connect.facebook.net; frame-src https://www.googletagmanager.com"
</IfModule>
# --- FIN BLOQUE SEGURIDAD ---

# Caché agresiva para estáticos versionados (?v=) — repeat visits y PageSpeed
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|mjs|png|jpe?g|webp|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
